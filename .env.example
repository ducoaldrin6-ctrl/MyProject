DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=myproject-jc1o.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://myproject-jc1o.onrender.com

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=aldrin.duco2526@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_TIMEOUT=8
DEFAULT_FROM_EMAIL=aldrin.duco2526@gmail.com

RECAPTCHA_SITE_KEY=your-recaptcha-v2-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-v2-secret-key

# Initial accounts. Keep real passwords only in .env or Render, never in Git.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-secure-admin-password
ADMIN_EMAIL=admin@example.com
STAFF_USERNAME=staff
STAFF_PASSWORD=choose-a-secure-staff-password
STAFF_EMAIL=staff@example.com

# Optional security/auth tuning
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
